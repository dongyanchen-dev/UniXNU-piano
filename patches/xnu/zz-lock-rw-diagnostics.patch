@@ -63,10 +63,30 @@
 #include <kern/processor.h>
 #include <kern/sched_prim.h>
 #include <kern/debug.h>
+#include <kern/backtrace.h>
 #include <machine/atomic.h>
 #include <machine/machine_cpu.h>
 
 KALLOC_TYPE_DEFINE(KT_LCK_RW, lck_rw_t, KT_PRIV_ACCT);
+
+/* Bring-up diagnostic: preserve the assertion, but leave the caller frames in
+ * the panic log before the assertion terminates the boot. */
+static void
+lck_rw_non_sleepable_diagnostic(const char *function, unsigned line)
+{
+	uintptr_t bt[8] = {0};
+	backtrace_info_t info = BTI_NONE;
+	unsigned int count = backtrace(bt, 8, NULL, &info);
+	panic("Taking non-sleepable RW lock at %s:%u\n"
+	    "BT count=%u flags=%x\n"
+	    "0=%016lx 1=%016lx 2=%016lx 3=%016lx\n"
+	    "4=%016lx 5=%016lx 6=%016lx 7=%016lx",
+	    function, line, count, (unsigned int)info,
+	    (unsigned long)bt[0], (unsigned long)bt[1],
+	    (unsigned long)bt[2], (unsigned long)bt[3],
+	    (unsigned long)bt[4], (unsigned long)bt[5],
+	    (unsigned long)bt[6], (unsigned long)bt[7]);
+}
 
 #define LCK_RW_WRITER_EVENT(lck)                (event_t)((uintptr_t)(lck)+1)
 #define LCK_RW_READER_EVENT(lck)                (event_t)((uintptr_t)(lck)+2)

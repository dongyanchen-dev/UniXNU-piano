+//
+// Report the UFS controller while it is still the one UEFI was driving.
+//
+// Every measurement so far came from the state after ExitBootServices, where
+// the first command never completes. This is the same controller moments
+// earlier, with payload.img freshly read through it, so the two can be
+// compared field by field.
+//
+//
+// Report the UFS controller while it is still the one UEFI was driving.
+//
+// Print() only reaches ConOut, and the firmware's memory log keeps DEBUG()
+// alone, so this uses DEBUG with EFI_D_ERROR - the level the rest of the boot
+// path already logs at - which makes the dump readable with
+// "fastboot oem debuglog" + "get_staged" while the menu is up.
+//
+STATIC
+VOID
+PianoUfsDump (
+  VOID
+  )
+{
+  volatile UINT32  *Ufs;
+  UINT64            List;
+  volatile UINT32  *Utrd;
+
+  Ufs = (volatile UINT32 *)(UINTN)0x1D84000;
+  DEBUG ((EFI_D_ERROR, "piano: ufs cap=%08x ver=%08x memcfg=%08x hcs=%08x\n",
+          Ufs[0x00 / 4], Ufs[0x08 / 4], Ufs[0x300 / 4], Ufs[0x30 / 4]));
+  DEBUG ((EFI_D_ERROR, "piano: ufs hce=%08x is=%08x ie=%08x db=%08x\n",
+          Ufs[0x34 / 4], Ufs[0x20 / 4], Ufs[0x24 / 4], Ufs[0x58 / 4]));
+  DEBUG ((EFI_D_ERROR, "piano: ufs utrl=%08x/%08x rsr=%08x\n",
+          Ufs[0x54 / 4], Ufs[0x50 / 4], Ufs[0x60 / 4]));
+  DEBUG ((EFI_D_ERROR, "piano: ufs utmrl=%08x/%08x tmrsr=%08x\n",
+          Ufs[0x74 / 4], Ufs[0x70 / 4], Ufs[0x80 / 4]));
+  DEBUG ((EFI_D_ERROR, "piano: ufs uic cmd=%08x arg1=%08x arg2=%08x arg3=%08x\n",
+          Ufs[0x90 / 4], Ufs[0x94 / 4], Ufs[0x98 / 4], Ufs[0x9C / 4]));
+
+  List = ((UINT64)Ufs[0x54 / 4] << 32) | Ufs[0x50 / 4];
+  if (List != 0) {
+    Utrd = (volatile UINT32 *)(UINTN)List;
+    DEBUG ((EFI_D_ERROR, "piano: ufs utrd %08x %08x %08x %08x %08x %08x %08x %08x\n",
+            Utrd[0], Utrd[1], Utrd[2], Utrd[3], Utrd[4], Utrd[5], Utrd[6], Utrd[7]));
+  }
+}
+
